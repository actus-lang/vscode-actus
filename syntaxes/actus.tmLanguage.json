{
  "name": "Actus",
  "scopeName": "source.actus",
  "fileTypes": ["act"],
  "patterns": [
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#keywords"},
    {"include": "#types"},
    {"include": "#functions"},
    {"include": "#numbers"},
    {"include": "#operators"}
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.triple-slash.actus",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.actus",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.actus",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {"name": "punctuation.definition.string.begin.actus"}
      },
      "endCaptures": {
        "0": {"name": "punctuation.definition.string.end.actus"}
      },
      "patterns": [
        {"name": "constant.character.escape.actus", "match": "\\\\."}
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.actus",
          "match": "\\b(?:verb|perform|case|return|import|open|drop|loop|break|continue|if)\\b"
        },
        {
          "name": "storage.type.actus",
          "match": "\\b(?:struct|enum|role)\\b"
        },
        {
          "name": "storage.modifier.actus",
          "match": "\\b(?:erg|abs|dat|ins|dynamic|meta|unsafe)\\b"
        },
        {
          "name": "variable.language.self.actus",
          "match": "\\bself\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.actus",
          "match": "\\b(?:Bool|Char|String|Int|I8|I16|I32|I64|U8|U16|U32|U64|Usize|F32|F64|Unit|Option|Result|Buffer)\\b"
        },
        {
          "name": "entity.name.type.actus",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.actus",
          "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.actus",
          "match": "\\b[0-9]+(?:_[0-9]+)*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.actus",
          "match": "=>|->|==|!=|<=|>=|[+*/<>=!-]"
        },
        {
          "name": "punctuation.bracket.actus",
          "match": "[{}()\\[\\]]"
        },
        {
          "name": "punctuation.delimiter.actus",
          "match": "[,;:.]"
        }
      ]
    }
  }
}
