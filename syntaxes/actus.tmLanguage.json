{
  "name": "Actus",
  "scopeName": "source.actus",
  "fileTypes": ["act"],
  "patterns": [
    {"include": "#comments"},
    {"include": "#docstrings"},
    {"include": "#strings"},
    {"include": "#keywords"},
    {"include": "#packNames"},
    {"include": "#types"},
    {"include": "#functions"},
    {"include": "#numbers"},
    {"include": "#operators"}
  ],
  "repository": {
    "docstrings": {
      "name": "comment.block.documentation.actus",
      "begin": "\\\"\\\"\\\"",
      "end": "\\\"\\\"\\\"",
      "beginCaptures": {
        "0": {"name": "punctuation.definition.comment.begin.actus"}
      },
      "endCaptures": {
        "0": {"name": "punctuation.definition.comment.end.actus"}
      }
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.triple-slash.actus",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.actus",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.actus",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {"name": "punctuation.definition.string.begin.actus"}
      },
      "endCaptures": {
        "0": {"name": "punctuation.definition.string.end.actus"}
      },
      "patterns": [
        {"name": "constant.character.escape.actus", "match": "\\\\."}
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.actus",
          "match": "\\b(?:verb|perform|case|return|import|open|drop|loop|break|continue|if|extern|at|as)\\b"
        },
        {
          "name": "storage.type.actus",
          "match": "\\b(?:struct|enum|role|pack)\\b"
        },
        {
          "name": "storage.modifier.pack.actus",
          "match": "\\b(?:layout|fields|storage)\\b"
        },
        {
          "name": "storage.modifier.endianness.actus",
          "match": "\\b(?:little|big)\\b"
        },
        {"name": "storage.modifier.ownership.erg.actus", "match": "\\berg\\b"},
        {"name": "storage.modifier.ownership.abs.actus", "match": "\\babs\\b"},
        {"name": "storage.modifier.ownership.dat.actus", "match": "\\bdat\\b"},
        {"name": "storage.modifier.ownership.ins.actus", "match": "\\bins\\b"},
        {
          "name": "storage.modifier.actus",
          "match": "\\b(?:dynamic|meta|unsafe)\\b"
        },
        {
          "name": "variable.language.self.actus",
          "match": "\\bself\\b"
        }
      ]
    },
    "packNames": {
      "patterns": [
        {
          "name": "entity.name.type.pack.actus",
          "match": "(?<=\\bpack\\s)[A-Z][a-zA-Z0-9_]*"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.actus",
          "match": "\\b(?:Bool|Char|String|Int|I8|I16|I32|I64|U8|U16|U32|U64|Usize|F32|F64|Unit|Option|Result|Buffer|Array|Void|[ui](?:[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])|f32|f64)\\b"
        },
        {
          "name": "entity.name.type.actus",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "constant.numeric.hex.actus",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "entity.name.function.actus",
          "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.actus",
          "match": "\\b[0-9]+(?:_[0-9]+)*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.actus",
          "match": "=>|->|<<|>>|&&|\\|\\||==|!=|<=|>=|%|~|[+*/<>=!&|^-]"
        },
        {
          "name": "punctuation.bracket.actus",
          "match": "[{}()\\[\\]]"
        },
        {
          "name": "punctuation.delimiter.actus",
          "match": "[,;:.]"
        }
      ]
    }
  }
}
